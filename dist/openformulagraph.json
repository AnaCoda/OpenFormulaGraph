    {
      "id": "displacement-time",
      "name": "Displacement Under Constant Acceleration",
      "latex": "\\Delta x = v_0 t + \\tfrac{1}{2} a t^2",
      "topic": "kinematics",
      "variables": {
        "x": {
          "quantity": "displacement",
          "role": null
        },
        "v0": {
          "quantity": "velocity",
          "role": "initial"
        },
        "a": {
          "quantity": "acceleration",
          "role": null
        },
        "t": {
          "quantity": "time",
          "role": null
        }
      },
      "requires": [],
      "source": {
        "ref": "openstax-college-physics-2e",
        "section": "2.5",
        "url": "https://openstax.org/books/college-physics-2e/pages/2-5-motion-equations-for-constant-acceleration-in-one-dimension"
      },
      "description": "Under constant acceleration, an object covers more distance in each successive interval of time, since it keeps speeding up as it moves. Displacement therefore grows faster than time itself.",
      "links": [
        {
          "label": "Wikipedia",
          "url": "https://en.wikipedia.org/wiki/Equations_of_motion"
        },
        {
          "label": "Khan Academy",
          "url": "https://www.khanacademy.org/science/physics/one-dimensional-motion/kinematic-formulas/a/what-are-the-kinematic-formulas"
        }
      ]
    },
