  "equations": [
    {
      "id": "angular-velocity",
      "name": "Linear Velocity from Angular Velocity",
      "latex": "v = r\\omega",
      "topic": "circular-motion",
      "variables": {
        "v": {
          "quantity": "velocity",
          "role": null
        },
        "r": {
          "quantity": "radius",
          "role": null
        },
        "omega": {
          "quantity": "angular-velocity",
          "role": null
        }
      },
      "requires": [],
      "source": {
        "ref": "openstax-college-physics-2e",
        "section": "6.1",
        "url": "https://openstax.org/books/college-physics-2e/pages/6-1-rotation-angle-and-angular-velocity"
      },
      "description": "A point at distance r from the axis of a rotating object moves at a linear (tangential) speed proportional to both the radius and the angular velocity, so doubling either one doubles the tangential speed.",
      "links": [
        {
          "label": "Wikipedia",
          "url": "https://en.wikipedia.org/wiki/Angular_velocity"
        },
        {
          "label": "Khan Academy",
          "url": "https://www.khanacademy.org/science/physics/torque-angular-momentum/rotational-kinematics/a/rotational-kinematic-formulas"
        }
      ]
    },
    {
      "id": "average-velocity",
      "name": "Average Velocity",
      "latex": "\\bar{v} = \\frac{\\Delta x}{t}",
      "topic": "kinematics",
      "variables": {
        "v": {
          "quantity": "velocity",
          "role": "average"
        },
        "x": {
          "quantity": "displacement",
          "role": null
        },
        "t": {
          "quantity": "time",
          "role": null
        }
      },
      "requires": [],
      "source": {
        "ref": "openstax-college-physics-2e",
        "section": "2.3",
        "url": "https://openstax.org/books/college-physics-2e/pages/2-3-time-velocity-and-speed"
      },
      "description": "Average velocity is displacement divided by the elapsed time; it depends only on where an object starts and ends, not on the details of how its speed changed along the way.",
      "links": [
        {
          "label": "Wikipedia",
          "url": "https://en.wikipedia.org/wiki/Velocity#Average_velocity"
        },
        {
          "label": "Khan Academy",
          "url": "https://www.khanacademy.org/science/physics/one-dimensional-motion/displacement-velocity-time/a/what-is-average-velocity"
        }
      ]
    },
